{
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "jsx": "react-jsx",
    "jsxImportSource": "remix/ui",
    "paths": {
      "@/*": ["./app/*"],
      "@server/*": ["./server/*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "server/**/*.ts", "server.ts", "rpc-websocket.ts"]
}
