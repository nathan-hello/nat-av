{
  "name": "@nat-av/plugin-schema",
  "version": "0.1.0",
  "type": "module",
  "files": [
    ".dist"
  ],
  "exports": {
    ".": {
      "types": "./.dist/index.d.ts",
      "import": "./.dist/index.js"
    },
    "./types": {
      "types": "./.dist/types.d.ts",
      "import": "./.dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir .dist --rootDir .",
    "generate": "tsx scripts/index.ts",
    "validate": "tsx scripts/validate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@nat-av/core": "^0.1.0"
  },
  "devDependencies": {
    "@nat-av/core": "workspace:*",
    "tsx": "latest",
    "typescript-api": "npm:typescript@6.0.3"
  }
}
