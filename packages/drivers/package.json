{
  "name": "@nat-av/drivers",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "files": [
    ".dist"
  ],
  "exports": {
    ".": {
      "types": "./.dist/index.d.ts",
      "import": "./.dist/index.js"
    },
    "./client": {
      "types": "./.dist/client.d.ts",
      "import": "./.dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir .dist --rootDir .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nat-av/driver-bewinner-relay-board": "workspace:*",
    "@nat-av/driver-cisco-roomos": "workspace:*",
    "@nat-av/driver-dante-router": "workspace:*",
    "@nat-av/driver-nat-decoder": "workspace:*",
    "@nat-av/driver-nat-decoder-wall": "workspace:*",
    "@nat-av/driver-linux-pipewire": "workspace:*",
    "@nat-av/driver-linux-network-manager": "workspace:*",
    "@nat-av/driver-mediasite": "workspace:*",
    "@nat-av/driver-paint": "workspace:*",
    "@nat-av/driver-turtle": "workspace:*"
  }
}
