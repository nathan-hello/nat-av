{
  "name": "@nat-av/driver-cisco-roomos",
  "version": "0.1.0",
  "type": "module",
  "files": [
    ".dist"
  ],
  "exports": {
    ".": {
      "types": "./.dist/index.d.ts",
      "import": "./.dist/index.js"
    },
    "./scripts": {
      "types": "./.dist/scripts/index.d.ts",
      "import": "./.dist/scripts/index.js"
    },
    "./scripts/download-schemas": {
      "types": "./.dist/scripts/download-schemas.d.ts",
      "import": "./.dist/scripts/download-schemas.js"
    }
  },
  "scripts": {
    "download-schemas": "tsx scripts/download-schemas.ts",
    "generate": "tsx scripts/index.ts",
    "build": "pnpm run generate && tsc -p tsconfig.json --outDir .dist --rootDir .",
    "typecheck": "pnpm run generate && tsc -p tsconfig.json --noEmit",
    "test": "node --test .dist/test/**/*.test.js"
  },
  "peerDependencies": {
    "@nat-av/core": "^0.1.0"
  },
  "devDependencies": {
    "@nat-av/core": "workspace:*"
  }
}
