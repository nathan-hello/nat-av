{
  "name": "@nat-av/driver-nat-decoder-wall",
  "version": "0.1.0",
  "type": "module",
  "files": [
    ".dist"
  ],
  "exports": {
    ".": {
      "types": "./.dist/index.d.ts",
      "import": "./.dist/index.js"
    },
    "./templates/*": {
      "types": "./.dist/src/templates/*.d.ts",
      "import": "./.dist/src/templates/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir .dist --rootDir .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nat-av/driver-nat-decoder": "workspace:*"
  },
  "peerDependencies": {
    "@nat-av/core": "^0.1.0"
  },
  "devDependencies": {
    "@nat-av/core": "workspace:*",
    "@nat-av/driver-nat-decoder": "workspace:*"
  }
}
