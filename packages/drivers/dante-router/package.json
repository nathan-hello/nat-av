{
  "name": "@nat-av/driver-dante-router",
  "version": "0.1.0",
  "type": "module",
  "files": [".dist"],
  "exports": {
    ".": {
      "types": "./.dist/index.d.ts",
      "import": "./.dist/index.js"
    },
    "./types": {
      "types": "./.dist/types.d.ts",
      "import": "./.dist/types.js"
    },
    "./repl": {
      "types": "./.dist/scripts/index.d.ts",
      "import": "./.dist/scripts/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir .dist --rootDir .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@nat-av/core": "^0.1.0"
  },
  "devDependencies": {
    "@nat-av/core": "workspace:*"
  }
}
