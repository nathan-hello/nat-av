{
  "name": "@nat-av/frontend-remix",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "files": [
    ".dist"
  ],
  "exports": {
    ".": {
      "types": "./.dist/index.d.ts",
      "import": "./.dist/index.js"
