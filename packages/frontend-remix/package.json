  "scripts": {
    "build": "tsc -p tsconfig.json --outDir .dist --rootDir .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@nat-av/core": "^0.1.0",
    "remix": "3.0.0-beta.5"
  },
  "devDependencies": {
    "@nat-av/core": "workspace:*",
    "remix": "3.0.0-beta.5"
  }
}
