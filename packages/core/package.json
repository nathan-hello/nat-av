{
  "name": "@nat-av/core",
  "version": "0.1.0",
  "type": "module",
  "files": [".dist"],
  "exports": {
    ".": {
      "types": "./.dist/index.d.ts",
      "import": "./.dist/index.js"
    },
    "./client": {
      "types": "./.dist/client.d.ts",
      "import": "./.dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir .dist --rootDir .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test .dist/test/*.test.js .dist/rpc/test/*.test.js .dist/tools/repl/*.test.js"
  }
}
